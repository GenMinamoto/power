{
  "name": "power",
  "version": "0.1.0",
  "private": true,
  "description": "ボディメイク記録アプリ（ローカル専用）",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch --disable-warning=ExperimentalWarning src/server/index.ts --dev\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/server/index.js",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.10",
    "@tanstack/react-query": "^5.107.1",
    "chart.js": "^4.6.1",
    "fastify": "^5.12.8",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
